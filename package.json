{
  "name": "@zthun/fashion",
  "version": "0.0.0",
  "description": "Frontend library used to design and layout web pages.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/fashion"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "clean": "rimraf --glob 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/*.tgz' 'packages/**/*.log' 'packages/**/stats'",
    "check": "tsc --noEmit",
    "test": "vitest run --coverage",
    "e2e": "cucumber-js",
    "lint": "eslint",
    "build": "lerna run build",
    "make": "yarn clean && yarn check && yarn lint && yarn test && yarn build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-angular": "^21.2.3",
    "@cucumber/cucumber": "^13.2.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/stylis": "^4.2.7",
    "@vitest/coverage-v8": "^5.0.3",
    "@zthun/janitor-eslint-config": "^21.2.4",
    "@zthun/janitor-ts-config": "^21.1.3",
    "@zthun/janitor-vite": "^21.2.4",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lerna": "^10.0.1",
    "lodash-es": "^4.18.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "yarn@4.18.1"
}
