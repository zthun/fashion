{
  "name": "@zthun/fashion",
  "version": "0.0.0",
  "description": "Frontend library used to design and layout web pages.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/fashion"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "clean": "rimraf --glob 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/*.tgz' 'packages/**/*.log' 'packages/**/stats'",
    "check": "tsc --noEmit",
    "test": "vitest run --coverage",
    "e2e": "cucumber-js",
    "lint": "eslint",
    "build": "lerna run build",
    "make": "yarn clean && yarn check && yarn lint && yarn test && yarn build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-angular": "^21.2.0",
    "@cucumber/cucumber": "^13.2.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/stylis": "^4.2.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@zthun/janitor-build-config": "^21.0.0",
    "@zthun/janitor-eslint-config": "^21.0.2",
    "@zthun/janitor-ts-config": "^21.0.0",
    "eslint": "10.8.1",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "lerna": "^10.0.0",
    "lodash-es": "^4.18.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@4.18.0"
}
