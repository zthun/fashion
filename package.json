{
  "name": "@zthun/fashion",
  "version": "0.0.0",
  "description": "Frontend library used to design and layout web pages.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/fashion"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "clean": "rimraf --glob 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/*.tgz' 'packages/**/*.log' 'packages/**/stats'",
    "check": "tsc --noEmit",
    "test": "vitest run --coverage",
    "e2e": "cucumber-js",
    "lint": "janitor-lint",
    "build": "lerna run build",
    "make": "yarn clean && yarn check && yarn lint && yarn test && yarn build",
    "postinstall": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@cucumber/cucumber": "^12.2.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.6.2",
    "@types/react": "^19.2.0",
    "@types/stylis": "^4.2.7",
    "@vitest/coverage-v8": "^3.2.4",
    "@zthun/janitor-build-config": "^19.3.6",
    "@zthun/janitor-lint": "^19.3.6",
    "@zthun/janitor-lint-config": "^19.3.6",
    "@zthun/janitor-options": "^19.3.6",
    "happy-dom": "^19.0.2",
    "husky": "^9.1.7",
    "lerna": "^9.0.0",
    "lodash-es": "^4.17.21",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^6.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@4.10.3"
}
