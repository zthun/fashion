{
  "name": "@zthun/fashion",
  "version": "0.0.0",
  "description": "Frontend library used to design and layout web pages.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/fashion"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "clean": "rimraf --glob 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/*.tgz' 'packages/**/*.log' 'packages/**/stats'",
    "check": "tsc --noEmit",
    "test": "vitest run --coverage",
    "e2e": "cucumber-js",
    "lint": "janitor-lint",
    "build": "lerna run build",
    "make": "yarn clean && yarn check && yarn lint && yarn test && yarn build",
    "postinstall": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@cucumber/cucumber": "^11.3.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.1",
    "@types/react": "^19.1.8",
    "@types/stylis": "^4.2.7",
    "@vitest/coverage-istanbul": "^3.2.3",
    "@zthun/janitor-build-config": "^19.2.0",
    "@zthun/janitor-lint": "^19.2.1",
    "@zthun/janitor-lint-config": "^19.2.1",
    "@zthun/janitor-options": "^19.2.1",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "lerna": "^8.2.2",
    "lodash-es": "^4.17.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^6.0.3",
    "tsx": "^4.20.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.3"
  },
  "resolutions": {
    "vite": "^6.0.0"
  },
  "packageManager": "yarn@4.6.0"
}
