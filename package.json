{
  "name": "@zthun/fashion",
  "version": "0.0.0",
  "description": "Frontend library used to design and layout web pages.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/fashion"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "clean": "rimraf --glob 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/*.tgz' 'packages/**/*.log' 'packages/**/stats'",
    "check": "tsc --noEmit",
    "test": "vitest run --coverage",
    "e2e": "cucumber-js",
    "lint": "eslint",
    "build": "lerna run build",
    "make": "yarn clean && yarn check && yarn lint && yarn test && yarn build",
    "postinstall": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-angular": "^21.0.1",
    "@cucumber/cucumber": "^12.9.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/stylis": "^4.2.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@zthun/janitor-build-config": "^20.0.6",
    "@zthun/janitor-eslint-config": "^20.0.7",
    "@zthun/janitor-ts-config": "^20.0.4",
    "eslint": "9.39.4",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lerna": "^9.0.7",
    "lodash-es": "^4.18.1",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "packageManager": "yarn@4.14.1"
}
