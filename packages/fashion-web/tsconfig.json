{
  "extends": [
    "@zthun/janitor-ts-config/base",
    "@zthun/janitor-ts-config/browser",
    "@zthun/janitor-ts-config/react"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@zthun/fashion-theme": ["../fashion-theme/src/index.mts"],
      "@zthun/fashion-theme-dark": ["../fashion-theme-dark/src/index.mts"],
      "@zthun/fashion-tailor": ["../fashion-tailor/src/index.mts"],
      "@zthun/fashion-boutique": ["../fashion-boutique/src/index.mts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "features/**/*.ts",
    "src/**/*.mts",
    "features/**/*.mts"
  ]
}
